# ---------------------------------------------------------------------------
# .gitignore — שכבת הגנה כדי ששום נתון אמת לא ייכנס למאגר הציבורי.
# המאגר הזה מכיל אך ורק נתונים סינתטיים (data/*.json שנוצרו ע"י המחולל).
# הכללים כאן חוסמים את סוגי הקבצים שבהם עלול לשבת נתון אמיתי.
# ---------------------------------------------------------------------------

# מאגרי נתונים אמיתיים
*.db
*.sqlite
*.sqlite3

# קובצי מקור אמיתיים (אקסל / CSV) — נתוני ההדגמה הם JSON בלבד
*.xlsx
*.xls
*.csv

# חריג יחיד ומכוון: קובץ הייצוא של ההדגמה. נבנה ע"י tools/build_export_xlsx.py
# אך ורק מ-data/*.json הסינתטיים — אין בו שום נתון אמת. זה מה שכפתורי
# "ייצוא אקסל" באתר מורידים.
!data/export.xlsx

# תיקיית נתוני אמת, אם תיווצר אי-פעם מקומית
data/real/
אקסלים_שנטענו/

# מסמכי Word (כולל מסמך ההנחיות) וקובצי נעילה זמניים של Office
*.docx
~$*

# פייתון
__pycache__/
*.pyc
.venv/
venv/

# סביבות פיתוח
.idea/
.vscode/
.DS_Store
